# Environment & Application
NODE_ENV=development
PORT=4000
APP_NAME=Loopin
APP_URL=https://loopin.codapi.site
API_URL=https://loopin.codapi.site/api/v1
NEXT_PUBLIC_APP_URL=https://loopin.codapi.site
NEXT_PUBLIC_API_URL=https://loopin.codapi.site/api/v1
NEXT_PUBLIC_WS_URL=wss://loopin.codapi.site

# PostgreSQL Database (Prisma)
DATABASE_URL="postgresql://loopin_user:loopin_secret_password@localhost:5432/loopin_v2?schema=public"

# Redis Cache & Real-time PubSub
REDIS_URL="redis://localhost:6379"

# JWT Authentication
JWT_ACCESS_SECRET="loopin_super_secret_access_jwt_key_2026_change_in_production"
JWT_ACCESS_EXPIRATION="15m"
JWT_REFRESH_SECRET="loopin_super_secret_refresh_jwt_key_2026_change_in_production"
JWT_REFRESH_EXPIRATION="30d"

# Cloudflare R2 / S3 Storage Abstraction
R2_ACCOUNT_ID="your_cloudflare_account_id"
R2_ACCESS_KEY_ID="your_r2_access_key"
R2_SECRET_ACCESS_KEY="your_r2_secret_key"
R2_BUCKET_NAME="loopin-media-prod"
R2_ENDPOINT="https://<account_id>.r2.cloudflarestorage.com"
R2_PUBLIC_DOMAIN="https://cdn.loopin.codapi.site"

# Admin Initial Credentials
ADMIN_EMAIL="admin@loopin.codapi.site"
ADMIN_INITIAL_PASSWORD="ChangeMeImmediately123!"

# Mail (SMTP) - Optional
SMTP_HOST="smtp.mailgun.org"
SMTP_PORT=587
SMTP_USER="postmaster@loopin.codapi.site"
SMTP_PASS="your_smtp_password"
SMTP_FROM="Loopin <noreply@loopin.codapi.site>"
