generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  USER
  MODERATOR
  ADMIN
  SUPER_ADMIN
}

enum ApplicationStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

enum MediaType {
  IMAGE
  VIDEO
}

enum CreditTransactionType {
  INITIAL_GRANT
  EVENT_CREATE
  PARTICIPANT_APPROVE
  PACKAGE_PURCHASE
  REFERRAL_BONUS
  ADMIN_ADJUSTMENT
}

enum NotificationType {
  EVENT_INVITE
  APPLICATION_RECEIVED
  APPLICATION_APPROVED
  APPLICATION_REJECTED
  NEW_MESSAGE
  NEW_LIKE
  NEW_COMMENT
  NEW_FOLLOWER
  SYSTEM_ALERT
}

model User {
  id              String           @id @default(uuid())
  email           String           @unique
  phone           String?          @unique
  passwordHash    String
  role            Role             @default(USER)
  isVerified      Boolean          @default(false)
  isPro           Boolean          @default(false)
  isBanned        Boolean          @default(false)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  profile         Profile?
  creditWallet    CreditWallet?
  hostedEvents    Event[]          @relation("EventHost")
  applications    EventApplication[]
  participations  EventParticipant[]
  eventLikes      EventLike[]
  eventComments   EventComment[]
  reels           Reel[]           @relation("UserReels")
  reelLikes       ReelLike[]
  reelComments    ReelComment[]
  eventRatings    EventRating[]

  sentMessages    Message[]        @relation("SentMessages")
  conversations   ConversationParticipant[]
  notifications   Notification[]

  following       Follow[]         @relation("Follower")
  followers       Follow[]         @relation("Following")

  sentReports     Report[]         @relation("ReporterUser")
  targetedReports Report[]         @relation("ReportedUser")
  blockedUsers    Block[]          @relation("Blocker")
  blockedBy       Block[]          @relation("Blocked")
  auditLogs       AuditLog[]

  @@index([email])
  @@index([role])
  @@index([createdAt])
}

model Profile {
  id              String           @id @default(uuid())
  userId          String           @unique
  user            User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  username        String           @unique
  name            String
  avatarUrl       String?
  bio             String?          @db.VarChar(500)
  city            String?
  district        String?
  trustScore      Int              @default(95)
  badgeTitle         String?          @default("Süper Organizatör")
  lookingFor         String?
  languages          String?
  zodiac             String?
  education          String?
  occupation         String?
  communicationStyle String?
  loveLanguage       String?
  pets               String?
  drinking           String?
  smoking            String?
  workout            String?
  gallery            String[]         @default([])
  interests          UserInterest[]
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt

  @@index([username])
  @@index([trustScore])
}

model Interest {
  id        String         @id @default(uuid())
  name      String         @unique
  icon      String?
  users     UserInterest[]
  events    EventTag[]
}

model UserInterest {
  id         String   @id @default(uuid())
  profileId  String
  profile    Profile  @relation(fields: [profileId], references: [id], onDelete: Cascade)
  interestId String
  interest   Interest @relation(fields: [interestId], references: [id], onDelete: Cascade)

  @@unique([profileId, interestId])
}

model Event {
  id              String             @id @default(uuid())
  title           String
  category        String
  dateText        String
  eventDate       DateTime
  location        String
  maxCapacity     Int
  currentCapacity Int                @default(0)
  isFull          Boolean            @default(false)
  priceType       String             @default("Herkes Kendi Öder")
  imageUrl        String
  description     String             @db.Text
  ageRange        String             @default("Her Yaşa Uygun")
  isCancelled     Boolean            @default(false)

  hostId          String
  host            User               @relation("EventHost", fields: [hostId], references: [id], onDelete: Cascade)

  applications    EventApplication[]
  participants    EventParticipant[]
  likes           EventLike[]
  comments        EventComment[]
  ratings         EventRating[]
  tags            EventTag[]
  images          EventImage[]
  checkIns        EventCheckIn[]

  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt

  @@index([hostId])
  @@index([category])
  @@index([eventDate])
  @@index([createdAt])
}

model EventImage {
  id        String   @id @default(uuid())
  eventId   String
  event     Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  url       String
  order     Int      @default(0)
}

model EventTag {
  id         String   @id @default(uuid())
  eventId    String
  event      Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  interestId String
  interest   Interest @relation(fields: [interestId], references: [id], onDelete: Cascade)

  @@unique([eventId, interestId])
}

model EventApplication {
  id        String            @id @default(uuid())
  eventId   String
  event     Event             @relation(fields: [eventId], references: [id], onDelete: Cascade)
  userId    String
  user      User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  status    ApplicationStatus @default(PENDING)
  note      String?
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt

  @@unique([eventId, userId])
  @@index([eventId])
  @@index([userId])
  @@index([status])
}

model EventParticipant {
  id        String   @id @default(uuid())
  eventId   String
  event     Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  joinedAt  DateTime @default(now())

  @@unique([eventId, userId])
  @@index([eventId])
  @@index([userId])
}

model EventCheckIn {
  id        String   @id @default(uuid())
  eventId   String
  event     Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  userId    String
  qrToken   String   @unique
  checkedIn Boolean  @default(false)
  checkInAt DateTime?
  createdAt DateTime @default(now())

  @@index([eventId, userId])
}

model EventLike {
  id        String   @id @default(uuid())
  eventId   String
  event     Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([eventId, userId])
  @@index([eventId])
}

model EventComment {
  id        String   @id @default(uuid())
  eventId   String
  event     Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  text      String   @db.VarChar(1000)
  createdAt DateTime @default(now())

  @@index([eventId])
  @@index([userId])
  @@index([createdAt])
}

model EventRating {
  id        String   @id @default(uuid())
  eventId   String
  event     Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  score     Int      @default(5)
  review    String?
  createdAt DateTime @default(now())

  @@unique([eventId, userId])
}

model Reel {
  id          String        @id @default(uuid())
  userId      String
  user        User          @relation("UserReels", fields: [userId], references: [id], onDelete: Cascade)
  caption     String        @db.VarChar(1000)
  mediaUrl    String
  mediaType   MediaType     @default(IMAGE)
  likes       ReelLike[]
  comments    ReelComment[]
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@index([userId])
  @@index([createdAt])
}

model ReelLike {
  id        String   @id @default(uuid())
  reelId    String
  reel      Reel     @relation(fields: [reelId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([reelId, userId])
  @@index([reelId])
}

model ReelComment {
  id        String   @id @default(uuid())
  reelId    String
  reel      Reel     @relation(fields: [reelId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  text      String   @db.VarChar(1000)
  createdAt DateTime @default(now())

  @@index([reelId])
  @@index([createdAt])
}

model Follow {
  id          String   @id @default(uuid())
  followerId  String
  follower    User     @relation("Follower", fields: [followerId], references: [id], onDelete: Cascade)
  followingId String
  following   User     @relation("Following", fields: [followingId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())

  @@unique([followerId, followingId])
  @@index([followerId])
  @@index([followingId])
}

model Block {
  id        String   @id @default(uuid())
  blockerId String
  blocker   User     @relation("Blocker", fields: [blockerId], references: [id], onDelete: Cascade)
  blockedId String
  blocked   User     @relation("Blocked", fields: [blockedId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([blockerId, blockedId])
}

model Conversation {
  id           String                    @id @default(uuid())
  isGroup      Boolean                   @default(false)
  title        String?
  participants ConversationParticipant[]
  messages     Message[]
  createdAt    DateTime                  @default(now())
  updatedAt    DateTime                  @updatedAt

  @@index([updatedAt])
}

model ConversationParticipant {
  id             String       @id @default(uuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  userId         String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  lastReadAt     DateTime     @default(now())
  unreadCount    Int          @default(0)

  @@unique([conversationId, userId])
  @@index([userId])
}

model Message {
  id             String       @id @default(uuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  senderId       String
  sender         User         @relation("SentMessages", fields: [senderId], references: [id], onDelete: Cascade)
  text           String       @db.Text
  isRead         Boolean      @default(false)
  createdAt      DateTime     @default(now())

  @@index([conversationId])
  @@index([senderId])
  @@index([createdAt])
}

model CreditWallet {
  id           String              @id @default(uuid())
  userId       String              @unique
  user         User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  balance      Int                 @default(10)
  transactions CreditTransaction[]
  updatedAt    DateTime            @updatedAt

  @@index([userId])
}

model CreditTransaction {
  id           String                @id @default(uuid())
  walletId     String
  wallet       CreditWallet          @relation(fields: [walletId], references: [id], onDelete: Cascade)
  amount       Int
  balanceAfter Int
  type         CreditTransactionType
  referenceId  String?
  description  String
  createdAt    DateTime              @default(now())

  @@index([walletId])
  @@index([type])
  @@index([createdAt])
}

model CreditPackage {
  id                              String   @id @default(uuid())
  name                            String
  price                           Float
  credits                         Int
  maxApprovedParticipantsPerEvent Int
  description                     String
  popularBadge                    String?
  isActive                        Boolean  @default(true)
  createdAt                       DateTime @default(now())
}

model Notification {
  id        String           @id @default(uuid())
  userId    String
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      NotificationType
  title     String
  body      String
  data      Json?
  isRead    Boolean          @default(false)
  createdAt DateTime         @default(now())

  @@index([userId])
  @@index([isRead])
  @@index([createdAt])
}

model Report {
  id             String   @id @default(uuid())
  reporterUserId String
  reporter       User     @relation("ReporterUser", fields: [reporterUserId], references: [id], onDelete: Cascade)
  reportedUserId String?
  reportedUser   User?    @relation("ReportedUser", fields: [reportedUserId], references: [id], onDelete: SetNull)
  targetEventId  String?
  targetReelId   String?
  reason         String
  details        String?
  status         String   @default("OPEN") // OPEN, IN_REVIEW, RESOLVED, DISMISSED
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([status])
  @@index([reporterUserId])
}

model AuditLog {
  id        String   @id @default(uuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  action    String
  entity    String
  entityId  String?
  metadata  Json?
  ipAddress String?
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([action])
  @@index([createdAt])
}
